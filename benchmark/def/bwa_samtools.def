Bootstrap: docker
From: ubuntu:24.04

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        bwa \
        samtools \
        ca-certificates \
        procps \
        gzip \
        bash

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export LC_ALL=C
    export PATH=/usr/bin:/bin:$PATH

%runscript
    exec "$@"

%test
    bwa 2>&1 | head -n 2
    samtools --version